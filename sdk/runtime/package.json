{
  "name": "@solwear/sdk",
  "version": "0.1.0",
  "description": "Typed application API for SolWear OS.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/solwear-sdk.js",
    "./global": "./dist/solwear-sdk.global.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/bundle.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
